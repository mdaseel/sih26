# ============================================================
#  SolarGrid AI — environment configuration
#  Copy (do not rename) to .env and fill in. NEVER commit .env.
#      cp .env.example .env
# ============================================================

# ---------- Supabase ----------
# The PROJECT URL, not the REST endpoint and not the database string.
# Find it in Project Settings -> API -> Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public "anon" key. Safe to expose to the browser — RLS constrains it.
SUPABASE_ANON_KEY=

# SECURITY (Rule 10): the service-role key bypasses ALL Row Level Security.
# BACKEND ONLY. Never prefix with NEXT_PUBLIC_. Never send it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used ONLY by backend/scripts/apply_migrations.py.
# Project Settings -> Database -> Connection string -> URI.
# Contains your database password: treat it exactly like a key.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Optional. Only needed if SUPABASE_URL above is unavailable; the project URL
# is derived from this by stripping /rest/v1.
SUPABASE_REST_API=

# ---------- Backend ----------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---------- Engineering artifacts ----------
# Directory holding the existing model/dataset/feeder files.
# Defaults to the repository root; override only if artifacts live elsewhere.
ARTIFACTS_DIR=

# ---------- Frontend (Next.js) ----------
# Only NEXT_PUBLIC_* reaches the browser. The service-role key and the database
# password are absent here by design — do not add them.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Routing (optional) ----------
# Without these, vendor distances are STRAIGHT-LINE and are labelled as such —
# never presented as travel distance. Set both to get real road routes from any
# OSRM-compatible service.
ROUTING_PROVIDER=
ROUTING_BASE_URL=
